<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.nearspot.controller.InicioController"
        spacing="15"
        style="-fx-padding: 30;">

    <Label
            text="NearSpot"
            style="-fx-font-size: 30px; -fx-font-weight: bold;" />

    <Label
            text="Encontrá productos y servicios cerca tuyo" />

    <HBox spacing="10">

        <ComboBox
                fx:id="cmbBusqueda"
                promptText="¿Qué estás buscando?"
                prefWidth="300" />

        <ComboBox
                fx:id="cmbOrdenamiento"
                promptText="Ordenar por..."
                prefWidth="200" />

        </HBox>

    <HBox spacing="10">


        <TextField
                fx:id="txtUbicacion"
                promptText="Ubicación"
                prefWidth="180" />        

    </HBox>


    <Button
                text="Buscar"
                onAction="#buscar" />

    <Label
            text="Prestadores disponibles"
            style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <ListView
        fx:id="listaPrestadores"
        prefWidth="700"
        prefHeight="400"
        style="
            -fx-background-color: transparent;
            -fx-border-color: transparent;
        " />

</VBox> 