<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.nearspot.controller.InicioController">

    <!-- MENÚ LATERAL IZQUIERDO -->
    <left>

    <VBox
            fx:id="menuLateral"
            spacing="15"
            prefWidth="180"
            style="
                -fx-background-color: #f3f3f3;
                -fx-padding: 20;
            ">

        <!-- ENCABEZADO -->
        <HBox
                spacing="10"
                alignment="CENTER_LEFT">

           <Button
        onAction="#toggleMenu"
        prefWidth="42"
        prefHeight="42"
        minWidth="42"
        maxWidth="42"
        style="
            -fx-background-color: transparent;
            -fx-border-color: transparent;
            -fx-cursor: hand;
            -fx-padding: 8;
        ">

    <graphic>
        <VBox
                spacing="4"
                alignment="CENTER">

            <Region
                    prefWidth="22"
                    prefHeight="2"
                    style="-fx-background-color: #333333;"/>

            <Region
                    prefWidth="22"
                    prefHeight="2"
                    style="-fx-background-color: #333333;"/>

            <Region
                    prefWidth="22"
                    prefHeight="2"
                    style="-fx-background-color: #333333;"/>

        </VBox>
    </graphic>

</Button>

            <Label
        fx:id="lblLogo"
        text="NearSpot"
        visible="false"
        managed="false"
        style="
            -fx-font-size: 20px;
            -fx-font-weight: bold;
        "/>

        </HBox>

        <Separator
        fx:id="separadorMenu"
        visible="false"
        managed="false"/>

        <!-- OPCIONES DEL MENÚ -->
        <VBox
                fx:id="opcionesMenu"
                spacing="10">

            <Button
                    text="Inicio"
                    maxWidth="Infinity"/>

            <Button
                    text="Mi perfil"
                    maxWidth="Infinity"
                    onAction="#verPerfil"/>

           <Button
                    text="Prestadores"
                    maxWidth="Infinity"

            <Button
                    text="Cerrar sesión"
                    maxWidth="Infinity"
                    onAction="#cerrarSesion"/>

        </VBox>

    </VBox>

</left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>

        <VBox
                spacing="15"
                style="-fx-padding: 30;">

            <Label
                    text="NearSpot"
                    style="
                        -fx-font-size: 30px;
                        -fx-font-weight: bold;
                    "/>

            <Label
                    text="Encontrá productos y servicios cerca tuyo"/>

            <HBox spacing="10">

                <ComboBox
                        fx:id="cmbBusqueda"
                        promptText="¿Qué estás buscando?"
                        prefWidth="300"/>

                <ComboBox
                        fx:id="cmbOrdenamiento"
                        promptText="Ordenar por..."
                        prefWidth="200"/>

            </HBox>

            <HBox spacing="10">

                <TextField
                        fx:id="txtUbicacion"
                        promptText="Ubicación"
                        prefWidth="180"/>

            </HBox>

            <Button
                    text="Buscar"
                    onAction="#buscar"/>

            <Label
                    text="Prestadores disponibles"
                    style="
                        -fx-font-size: 18px;
                        -fx-font-weight: bold;
                    "/>

            <ListView
                    fx:id="listaPrestadores"
                    prefWidth="700"
                    prefHeight="400"
                    VBox.vgrow="ALWAYS"
                    style="
                        -fx-background-color: transparent;
                        -fx-border-color: transparent;
                    "/>

        </VBox>

    </center>

</BorderPane>